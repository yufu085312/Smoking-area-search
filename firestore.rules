rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ユーザーが管理者かどうかを判定
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // バリデーション関数: 喫煙所データ
    function isValidSmokingArea() {
      let data = request.resource.data;
      return data.keys().hasAll(['latitude', 'longitude', 'createdById', 'createdAt', 'status']) &&
             data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
             data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
             data.createdById is string && data.createdById == request.auth.uid &&
             data.createdAt is timestamp &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (!data.keys().hasAny(['memo']) || (data.memo is string && data.memo.size() <= 500));
    }

    // バリデーション関数: 報告データ
    function isValidReport() {
      let data = request.resource.data;
      return data.keys().hasAll(['smokingAreaId', 'reason', 'reportedById', 'reportedAt']) &&
             data.smokingAreaId is string &&
             data.reason in ['closed', 'relocated', 'no_cigarettes', 'other'] &&
             data.reportedById is string && data.reportedById == request.auth.uid &&
             data.reportedAt is timestamp &&
             (!data.keys().hasAny(['comment']) || (data.comment is string && data.comment.size() <= 500));
    }

    // 喫煙所データのコレクション
    match /smokingAreas/{areaId} {
      // 公開済みデータ、または自分の投稿、または管理者は読み取り可能
      allow read: if resource.data.status == 'approved' || 
                    (request.auth != null && (request.auth.uid == resource.data.createdById || isAdmin()));
      
      // 認証済みユーザーは 'pending' ステータスでのみ作成可能
      allow create: if request.auth != null && 
                      isValidSmokingArea() && 
                      request.resource.data.status == 'pending';
      
      // 管理者は任意のフィールドを更新可能
      // 一般ユーザーはステータス以外の更新を許可（必要に応じて制限）
      allow update: if isAdmin() || 
                      (request.auth != null && 
                       request.auth.uid == resource.data.createdById && 
                       isValidSmokingArea() && 
                       request.resource.data.status == resource.data.status); // ステータス変更は不可
      
      // 管理者、または自分の投稿のみ削除可能
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.createdById);
    }
    
    // ユーザーデータのコレクション
    match /users/{userId} {
      // 自分のデータのみ読み取り可能
      allow read: if request.auth != null && request.auth.uid == userId;
      // 作成は認証データと一致する場合のみ（roleはデフォルトでuserになることを期待、または管理権限チェック）
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.role == 'user';
      // 更新は管理者のみ（roleの変更を防ぐため）
      allow update: if isAdmin();
    }

    // 報告データのコレクション
    match /reports/{reportId} {
      allow create: if request.auth != null && isValidReport();
      // 報告内容は管理者のみ閲覧可能とするのが一般的
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.reportedById);
    }
  }
}
